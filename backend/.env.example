# Copy this file to .env (same folder) and fill in what you use. .env is never shared or committed.

# Live AIS positions: a free key from https://aisstream.io (used by scripts/ais_listener.py)
AISSTREAM_API_KEY=

# Position feed for onboard VSAT/GPS gateways (POST /api/positions/feed). Any long random string; give the same
# value to the gateway as its X-Feed-Key header. Leave empty to keep the feed switched off.
MARIS_FEED_KEY=
